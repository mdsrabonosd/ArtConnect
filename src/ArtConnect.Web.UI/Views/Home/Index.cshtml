@{
    ViewData["Title"] = "Home";
}

<section class="public-hero">
    <h1>Original paintings, and a way to commission your own.</h1>
    <p>ArtConnect brings painters and art lovers together. The public gallery is the next phase. You can already create an account and manage your profile.</p>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole(AppRoles.Admin))
        {
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Open admin panel</a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Create account</a>
            <a class="btn btn-outline-secondary" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
        }
        else
        {
            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Profile">My account</a>
        }
    </div>
</section>
