@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["Wide"] = true;
}

<section class="hero">
    <div class="hero-text">
        <h1>Original paintings, and a way to commission your own.</h1>
        <p>Browse work from painters near you, or post a custom request with your budget and let artists send you proposals.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-controller="Gallery" asp-action="Index">Browse the gallery</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Register">Create an account</a>
            }
        </div>
    </div>
    <ol class="hero-steps">
        <li><strong>Discover</strong><span>Explore original artwork and artists.</span></li>
        <li><strong>Connect</strong><span>Like, comment and follow your favourites.</span></li>
        <li><strong>Commission</strong><span>Request custom art and compare proposals.</span></li>
    </ol>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="chip-row" aria-label="Categories">
        @foreach (var category in Model.Categories)
        {
            <a class="chip" asp-controller="Gallery" asp-action="Index" asp-route-CategoryId="@category.Id">@category.Name</a>
        }
    </section>
}

<section class="mt-4">
    <div class="section-head">
        <h2>Latest paintings</h2>
        <a asp-controller="Gallery" asp-action="Index">See all</a>
    </div>
    @if (Model.Latest.Count == 0)
    {
        <div class="empty panel"><i class="bi bi-image"></i><p>No paintings yet. Artists can upload the first one from their studio.</p></div>
    }
    else
    {
        <div class="art-grid">
            @foreach (var art in Model.Latest)
            {
                <partial name="_ArtworkCard" model="art" />
            }
        </div>
    }
</section>
