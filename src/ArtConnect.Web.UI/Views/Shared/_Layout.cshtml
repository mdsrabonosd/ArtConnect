@{
    var cartCount = 0;
    if (User.IsInRole(AppRoles.Customer) && Context.Session.IsAvailable)
    {
        cartCount = SessionCart.Count(Context.Session);
    }
    var wide = ViewData["Wide"] is true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <title>@ViewData["Title"] · ArtConnect</title>
</head>
<body class="public-body">
    <header class="public-bar">
        <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index">ArtConnect</a>
        <nav class="public-links">
            <a asp-area="" asp-controller="Gallery" asp-action="Index">Gallery</a>
            <a asp-area="" asp-controller="Artists" asp-action="Index">Artists</a>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin panel</a>
                }
                if (User.IsInRole(AppRoles.Artist))
                {
                    <a class="btn btn-primary btn-sm" asp-area="Artist" asp-controller="Dashboard" asp-action="Index">Artist studio</a>
                }
                if (User.IsInRole(AppRoles.Customer))
                {
                    <a class="btn btn-primary btn-sm" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">My space</a>
                    <a class="btn btn-outline-light btn-sm" asp-area="Customer" asp-controller="Cart" asp-action="Index"><i class="bi bi-bag"></i> Cart@(cartCount > 0 ? $" ({cartCount})" : "")</a>
                }
                <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> Account</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Create account</a>
            }
        </div>
    </header>
    <main class="public-main @(wide ? "wide" : "")">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
