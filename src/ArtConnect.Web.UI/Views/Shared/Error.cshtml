@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="public-hero">
    <h1>Something went wrong.</h1>
    <p>The page could not be loaded. Go back and try again, or return to the home page.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</section>
