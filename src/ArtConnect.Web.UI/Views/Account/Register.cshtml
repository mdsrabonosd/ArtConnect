@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
    var isArtist = Model.Role == AppRoles.Artist;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <title>Create account · ArtConnect</title>
</head>
<body class="login-body">
    <div class="login-shell">
        <aside class="login-aside">
            <span class="brand-mark">ArtConnect</span>
            <p class="login-statement">Show your paintings, or find the artist for yours.</p>
        </aside>
        <section class="login-form-wrap">
            <form asp-action="Register" method="post" class="login-form register-form" novalidate>
                <h1>Create account</h1>
                <p class="muted">It takes less than a minute.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="role-pick mb-3" role="radiogroup" aria-label="Account type">
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="@AppRoles.Customer" />
                        <span><strong>Customer</strong><small>Buy paintings and request custom work</small></span>
                    </label>
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="@AppRoles.Artist" />
                        <span><strong>Artist</strong><small>Show a portfolio and sell paintings</small></span>
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div id="artist-fields" class="@(isArtist ? "" : "d-none")">
                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label">Short bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="3" maxlength="1000" placeholder="Your style, mediums and what you love to paint"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ExperienceYears" class="form-label"></label>
                        <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="80" />
                        <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least 8 characters with a capital letter, a small letter and a number.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Create account</button>
                <p class="text-center muted mt-3 mb-0">Already have an account? <a asp-action="Login">Sign in</a></p>
            </form>
        </section>
    </div>

    <partial name="_ValidationScripts" />
    <script>
        (function () {
            var radios = document.querySelectorAll('input[name="Role"]');
            var artistFields = document.getElementById('artist-fields');
            function sync() {
                var selected = document.querySelector('input[name="Role"]:checked');
                var isArtist = selected && selected.value === 'Artist';
                artistFields.classList.toggle('d-none', !isArtist);
            }
            radios.forEach(function (r) { r.addEventListener('change', sync); });
            sync();
        })();
    </script>
</body>
</html>
