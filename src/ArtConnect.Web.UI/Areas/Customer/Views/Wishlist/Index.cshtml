@model List<Wishlist>
@{
    ViewData["Title"] = "Wishlist";
}
<div class="page-head">
    <div>
        <h1>Wishlist</h1>
        <p>Paintings you saved for later.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty panel"><i class="bi bi-heart"></i><p>Your wishlist is empty. Save paintings from the gallery with the Save button.</p>
        <a class="btn btn-primary" asp-area="" asp-controller="Gallery" asp-action="Index">Browse the gallery</a></div>
}
else
{
    <div class="art-grid">
        @foreach (var item in Model.Where(w => w.Artwork != null))
        {
            <div class="wish-item">
                <partial name="_ArtworkCard" model="item.Artwork" />
                <form asp-action="Remove" asp-route-artworkId="@item.ArtworkId" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100"><i class="bi bi-bookmark-x"></i> Remove</button>
                </form>
            </div>
        }
    </div>
}
