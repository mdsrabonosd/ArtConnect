@model CustomRequest
@{
    ViewData["Title"] = "New custom request";
    var categories = (List<SelectListItem>)ViewBag.Categories;
}
<div class="page-head">
    <div>
        <h1>New custom request</h1>
        <p>Describe the painting you want. Artists will reply with a price and delivery time.</p>
    </div>
</div>

<section class="panel form-panel">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="200" placeholder="Family portrait, oil on canvas" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="categories">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CanvasSize" class="form-label">Canvas size</label>
                <input asp-for="CanvasSize" class="form-control" maxlength="50" placeholder="24 x 30 in" />
                <span asp-validation-for="CanvasSize" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BudgetMin" class="form-label">Minimum budget (BDT)</label>
                <input asp-for="BudgetMin" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="BudgetMin" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BudgetMax" class="form-label">Maximum budget (BDT)</label>
                <input asp-for="BudgetMax" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="BudgetMax" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Deadline" class="form-label">Needed by</label>
                <input asp-for="Deadline" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <div class="form-text">At least 3 days from today.</div>
                <span asp-validation-for="Deadline" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label class="form-label" for="referenceImage">Reference photo (optional, JPG or PNG, up to 5 MB)</label>
                <input type="file" id="referenceImage" name="referenceImage" class="form-control" accept=".jpg,.jpeg,.png" />
                @Html.ValidationMessage("referenceImage", new { @class = "text-danger small" })
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">What should the painting show?</label>
                <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Publish request</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
