@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <title>@ViewData["Title"] · ArtConnect Admin</title>
</head>
<body>
    <div class="shell">
        <div class="sidebar-backdrop" data-toggle-sidebar></div>
        <aside class="sidebar" id="sidebar">
            <a class="brand-mark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">ArtConnect</a>
            <span class="sidebar-sub">Admin studio</span>

            <nav class="side-nav">
                <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

                <span class="side-group">People</span>
                <a class="@Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a>
                <a class="@Active("Artists")" asp-area="Admin" asp-controller="Artists" asp-action="Index"><i class="bi bi-person-video2"></i> Artists</a>

                <span class="side-group">Catalogue</span>
                <a class="@Active("Artworks")" asp-area="Admin" asp-controller="Artworks" asp-action="Index"><i class="bi bi-image"></i> Artworks</a>
                <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a>

                <span class="side-group">Commissions</span>
                <a class="@Active("CustomRequests")" asp-area="Admin" asp-controller="CustomRequests" asp-action="Index"><i class="bi bi-brush"></i> Custom requests</a>
                <a class="@Active("ArtistProposals")" asp-area="Admin" asp-controller="ArtistProposals" asp-action="Index"><i class="bi bi-chat-left-text"></i> Proposals</a>
                <a class="@Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check"></i> Orders</a>

                <span class="side-group">Community</span>
                <a class="@Active("Comments")" asp-area="Admin" asp-controller="Comments" asp-action="Index"><i class="bi bi-chat-dots"></i> Comments</a>
                <a class="@Active("Reviews")" asp-area="Admin" asp-controller="Reviews" asp-action="Index"><i class="bi bi-star"></i> Reviews</a>
            </nav>
        </aside>

        <div class="main">
            <header class="topbar">
                <button class="icon-btn d-lg-none" type="button" aria-label="Open menu" data-toggle-sidebar><i class="bi bi-list"></i></button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-user">
                    <span class="user-chip"><i class="bi bi-person-circle"></i> @User.Identity?.Name</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                    </form>
                </div>
            </header>

            <main class="content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
