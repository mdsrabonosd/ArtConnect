@model ArtistProposal
@{
    ViewData["Title"] = "Delete proposal";
}
<div class="page-head">
    <div>
        <h1>Delete proposal</h1>
        <p>A proposal that created an order cannot be deleted.</p>
    </div>
</div>

<section class="panel form-panel">
    <p class="confirm-text">Delete the proposal from <strong>@Model.ArtistProfile.User.FullName</strong> for @Model.CustomRequest.Title?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete proposal</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
