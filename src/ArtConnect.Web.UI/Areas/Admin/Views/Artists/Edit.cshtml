@model ArtistProfile
@{
    ViewData["Title"] = "Edit artist profile";
}
<div class="page-head">
    <div>
        <h1>Edit artist profile</h1>
        <p>Update the public details of this artist.</p>
    </div>
</div>

<section class="panel form-panel">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Artist account</label>
                <input class="form-control" value="@Model.User?.FullName (@Model.User?.Email)" disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="ExperienceYears" class="form-label"></label>
                <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="80" />
                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="4" maxlength="1000"></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Skills" class="form-label"></label>
                <input asp-for="Skills" class="form-control" maxlength="300" />
                <span asp-validation-for="Skills" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ProfilePhotoUrl" class="form-label"></label>
                <input asp-for="ProfilePhotoUrl" class="form-control" maxlength="500" />
                <span asp-validation-for="ProfilePhotoUrl" class="text-danger small"></span>
            </div>
        </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
    </form>
</section>
