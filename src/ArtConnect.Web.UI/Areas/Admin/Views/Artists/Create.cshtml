@model ArtistProfile
@{
    ViewData["Title"] = "Add artist profile";
    var users = (List<SelectListItem>)ViewBag.Users;
}
<div class="page-head">
    <div>
        <h1>Add artist profile</h1>
        <p>Attach a profile to a user who has the Artist role.</p>
    </div>
</div>

<section class="panel form-panel">
    @if (users.Count == 0)
    {
        <div class="empty">
            <i class="bi bi-person-plus"></i>
            <p>Every Artist user already has a profile. Create a new user with the Artist role first.</p>
            <a class="btn btn-primary" asp-controller="Users" asp-action="Create">Add user</a>
        </div>
    }
    else
    {
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label"></label>
                    <select asp-for="UserId" class="form-select" asp-items="users"></select>
                    <span asp-validation-for="UserId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExperienceYears" class="form-label"></label>
                    <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="80" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Bio" class="form-label"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4" maxlength="1000"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Skills" class="form-label"></label>
                    <input asp-for="Skills" class="form-control" maxlength="300" />
                    <span asp-validation-for="Skills" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProfilePhotoUrl" class="form-label"></label>
                    <input asp-for="ProfilePhotoUrl" class="form-control" maxlength="500" />
                    <span asp-validation-for="ProfilePhotoUrl" class="text-danger small"></span>
                </div>
            </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save profile</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
        </form>
    }
</section>
