@model Comment
@{
    ViewData["Title"] = "Delete comment";
}
<div class="page-head">
    <div>
        <h1>Delete comment</h1>
        <p>The comment is hidden from the system. The record stays in the database.</p>
    </div>
</div>

<section class="panel form-panel">
    <p class="confirm-text">Delete this comment by <strong>@Model.User.FullName</strong>?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete comment</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
