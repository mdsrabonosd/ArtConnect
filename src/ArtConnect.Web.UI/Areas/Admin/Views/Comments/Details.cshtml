@model Comment
@{
    ViewData["Title"] = "Comment details";
}
<div class="page-head">
    <div>
        <h1>Comment details</h1>
        <p></p>
    </div>
</div>

<section class="panel form-panel">
    <dl class="detail-list">
        <dt>Artwork</dt><dd>@(Model.Artwork?.Title ?? "(deleted artwork)")</dd>
        <dt>Written by</dt><dd>@Model.User.FullName (@Model.User.Email)</dd>
        <dt>Comment</dt><dd>@Model.Text</dd>
        <dt>Posted</dt><dd>@Model.CreatedAt.ToDateText()</dd>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</section>
