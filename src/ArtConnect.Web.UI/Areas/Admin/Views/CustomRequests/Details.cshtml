@model CustomRequest
@{
    ViewData["Title"] = "Custom request details";
}
<div class="page-head">
    <div>
        <h1>Custom request details</h1>
        <p></p>
    </div>
</div>

<section class="panel form-panel">
    <dl class="detail-list">
        <dt>Title</dt><dd>@Model.Title</dd>
        <dt>Customer</dt><dd>@Model.Customer.FullName (@Model.Customer.Email)</dd>
        <dt>Category</dt><dd>@Model.Category.Name</dd>
        <dt>Canvas size</dt><dd>@Model.CanvasSize</dd>
        <dt>Budget</dt><dd>@Model.BudgetMin.ToMoney() to @Model.BudgetMax.ToMoney()</dd>
        <dt>Deadline</dt><dd>@Model.Deadline.ToDateText()</dd>
        <dt>Status</dt><dd>@Model.Status</dd>
        <dt>Reference image</dt><dd>@(string.IsNullOrWhiteSpace(Model.ReferenceImageUrl) ? "-" : Model.ReferenceImageUrl)</dd>
        <dt>Description</dt><dd>@Model.Description</dd>
        <dt>Created</dt><dd>@Model.CreatedAt.ToDateText()</dd>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</section>
