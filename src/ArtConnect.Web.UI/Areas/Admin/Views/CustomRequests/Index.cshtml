@model List<CustomRequest>
@{
    ViewData["Title"] = "Custom requests";
}
<div class="page-head">
    <div>
        <h1>Custom requests</h1>
        <p>Painting requests posted by customers, with their budget and deadline.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add custom request</a>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty"><i class="bi bi-brush"></i><p>No custom requests yet. Requests appear here when customers post them, or you can add one.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table ledger">
                <thead><tr><th>Title</th><th>Customer</th><th>Category</th><th>Budget</th><th>Deadline</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Customer.FullName</td>
                        <td>@item.Category.Name</td>
                        <td>@item.BudgetMin.ToMoney() to @item.BudgetMax.ToMoney()</td>
                        <td>@item.Deadline.ToDateText()</td>
                        <td><span class="pill @(item.Status == RequestStatus.Open ? "pill-ok" : item.Status == RequestStatus.Cancelled ? "pill-bad" : item.Status == RequestStatus.Accepted ? "pill-role" : "pill-muted")">@item.Status</span></td>
                        <td class="text-end row-actions">
                            <a class="icon-btn" asp-action="Details" asp-route-id="@item.Id" title="View"><i class="bi bi-eye"></i></a>
                            <a class="icon-btn" asp-action="Edit" asp-route-id="@item.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a class="icon-btn danger" asp-action="Delete" asp-route-id="@item.Id" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
