@model CustomRequest

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Customers">
                <option value="">Select...</option>
            </select>
        <span asp-validation-for="CustomerId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Categories">
                <option value="">Select...</option>
            </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control" maxlength="200" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CanvasSize" class="form-label">Canvas size (e.g. 24 x 30 in)</label>
        <input asp-for="CanvasSize" class="form-control" maxlength="50" />
        <span asp-validation-for="CanvasSize" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BudgetMin" class="form-label">Minimum budget (BDT)</label>
        <input asp-for="BudgetMin" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="BudgetMin" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BudgetMax" class="form-label">Maximum budget (BDT)</label>
        <input asp-for="BudgetMax" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="BudgetMax" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Deadline" class="form-label">Deadline</label>
        <input asp-for="Deadline" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
        <span asp-validation-for="Deadline" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<RequestStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ReferenceImageUrl" class="form-label">Reference image URL (optional)</label>
        <input asp-for="ReferenceImageUrl" class="form-control" maxlength="500" />
        <span asp-validation-for="ReferenceImageUrl" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
