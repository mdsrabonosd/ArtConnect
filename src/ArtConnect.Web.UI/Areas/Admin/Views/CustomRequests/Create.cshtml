@model CustomRequest
@{
    ViewData["Title"] = "Add custom request";
}
<div class="page-head">
    <div>
        <h1>Add custom request</h1>
        <p>Fill in the details and save.</p>
    </div>
</div>

<section class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save custom request</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
