@model Artwork
@{
    ViewData["Title"] = "Delete artwork";
}
<div class="page-head">
    <div>
        <h1>Delete artwork</h1>
        <p>The artwork is hidden from the system. The record stays in the database.</p>
    </div>
</div>

<section class="panel form-panel">
    <p class="confirm-text">Delete <strong>@Model.Title</strong> by @Model.ArtistProfile.User.FullName?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete artwork</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
