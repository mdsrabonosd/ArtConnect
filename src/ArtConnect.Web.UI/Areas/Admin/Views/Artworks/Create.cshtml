@model Artwork
@{
    ViewData["Title"] = "Add artwork";
}
<div class="page-head">
    <div>
        <h1>Add artwork</h1>
        <p>Upload a painting and assign it to an artist.</p>
    </div>
</div>

<section class="panel form-panel">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save artwork</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
    </form>
</section>
