@model Review

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="OrderId" class="form-label">Delivered order</label>
        <select asp-for="OrderId" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Orders">
                <option value="">Select...</option>
            </select>
        <span asp-validation-for="OrderId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Rating" class="form-label">Rating</label>
        <select asp-for="Rating" class="form-select">
                @for (var i = 5; i >= 1; i--)
                {
                    <option value="@i">@i out of 5</option>
                }
            </select>
        <span asp-validation-for="Rating" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Comment" class="form-label">Comment (optional)</label>
        <textarea asp-for="Comment" class="form-control" rows="4" maxlength="500"></textarea>
        <span asp-validation-for="Comment" class="text-danger small"></span>
    </div>
</div>
